# /etc/blueberry-repo-sync.conf — overrides for blueberry-repo-sync.
# Copy to /etc/blueberry-repo-sync.conf and edit. All values are optional.

# Git repo holding the PKGBUILD recipes (packages/*/PKGBUILD).
REPO_URL=https://github.com/zsigisti/blueberry.git
BRANCH=master

# Working directory: holds the git clone and the build staging area.
WORK=/var/lib/blueberry-repo

# Built-package cache (persists across runs). A recipe is rebuilt only when its
# PKGBUILD changes, keyed by the PKGBUILD's SHA-256 — so unchanged packages
# (e.g. gcc) are reused in seconds instead of recompiled every sync. Delete this
# directory to force a full rebuild. Defaults to $WORK/pkgcache.
#CACHE=/var/lib/blueberry-repo/pkgcache

# Published web root — point your nginx server block here.
OUT=/var/www/html/x86_64

# Container engine and build image. Rocky Linux ships podman.
ENGINE=podman
IMAGE=docker.io/library/archlinux:latest

# Index signing. The published bpm.index is signed on the host with this
# ECDSA P-256 private key; bpm refuses an index not signed by the matching
# baked-in key. Generate with:
#   openssl ecparam -name prime256v1 -genkey -noout -out repo-signing-key.pem
# and bake the public half into bpm (tools/mkrepokey.sh in the blueberry repo).
SIGN_KEY=/etc/blueberry/repo-signing-key.pem

# Set to 1 to publish an UNSIGNED index (clients reject it unless they set
# BPM_ALLOW_UNSIGNED). Leave at 0 in production.
ALLOW_UNSIGNED=0
